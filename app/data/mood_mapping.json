  "patterns": {
    "mediterranean_base": {
      "emphasize_groups": ["vegetables", "fruits", "legumes", "nuts", "whole_grains", "olive_oil", "fish"],
      "limit_groups": ["ultra_processed", "refined_sweets"],
      "description": "Mediterranean dietary pattern associated with improved mood outcomes (SMILES trial)"
    },
    "low_ultra_processed": {
      "max_servings": 0,
      "description": "Minimize ultra-processed foods which correlate with worse mood"
    },
    "limit_high_caffeine": {
      "max_mg": 150,
      "description": "Moderate caffeine to avoid anxiety spikes"
    },
    "stabilize_glycemia": {
      "pairings": ["protein+fiber", "fat+fiber"],
      "avoid": ["high_added_sugar"],
      "description": "Protein and fiber slow glucose absorption, preventing mood-disrupting blood sugar swings"
    }
